# demo: zero-cost deterministic dialogue; openai: any OpenAI-compatible endpoint.
AI_MODE=demo

# Local Ollama example:
# AI_MODE=openai
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=qwen3:8b

# Cloud providers can use the same interface. Never expose this key in browser code.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen3:8b
AI_TIMEOUT_MS=15000
PORT=4173
HOST=127.0.0.1

# Optional conversion links shown on title and ending screens.
WISHLIST_URL=
COMMUNITY_URL=
