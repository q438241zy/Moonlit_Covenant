{
  "name": "moonlit-covenant-ai-jrpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playable web vertical slice for an AI-native JRPG with deterministic game rules and bounded NPC dialogue.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "test:cards": "node --test test/battle.test.mjs test/cards-ai.test.mjs test/cardpack.test.mjs",
    "test:deploy": "node --test test/deploy-contents.test.mjs",
    "art": "node tools/art/build-all.mjs",
    "art:portraits": "node tools/art/portrait/build.mjs",
    "art:cards": "node tools/art/build-cards.mjs",
    "art:paint": "node tools/art/raster/generate.mjs",
    "art:paint:finalize": "node tools/art/raster/finalize.mjs",
    "art:legacy-jpg": "node tools/art/raster/compress-legacy.mjs",
    "story:check": "node tools/story/check.mjs",
    "check": "node tools/check-syntax.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
