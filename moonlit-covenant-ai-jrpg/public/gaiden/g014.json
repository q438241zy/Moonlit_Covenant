              "label": "安慰塞雷娜",
              "desc": "对塞雷娜说话：别哭、我陪你、我们会告诉她。",
              "keywords": ["塞雷娜","别哭","我陪你","会告诉她","我们会告诉她","我在"],
              "morality": 1,
              "reaction": [{"t":"narr","text":"{PLAYER_NAME}站到塞雷娜身边。"},{"t":"say","who":"dawn_lord","text":"……有你们在她身边，我就放心了。"}],
              "reactionFixed": true,
              "set": {"flags":{"GD_CH14_FAREWELL":"SERENA"}}
