              "keywords": ["谢谢你","谢谢","原谅你","原谅","辛苦了","再见","一路走好","安息"],
              "morality": 1,
              "reaction": [
                {"t":"narr","text":"黎明卿愣了一下。"},
                {"t":"say","who":"dawn_lord","text":"……谢谢？对我？"},
                {"t":"narr","text":"她笑了。那个笑，和记忆空间里蹲下来替女儿理领子的女人，一模一样。"}
              ],
